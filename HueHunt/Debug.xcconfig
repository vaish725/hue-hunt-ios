// Base configuration for Debug builds. Assign this in Xcode: select the project file, the
// Info tab, and set it as the "Based on Configuration File" for Debug (per target or at the
// project level, matching how Release.xcconfig is assigned).
#include? "Secrets.xcconfig"

INFOPLIST_KEY_SUPABASE_URL = $(SUPABASE_URL)
INFOPLIST_KEY_SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)
