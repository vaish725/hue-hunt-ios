// Base configuration for Release builds, assigned via the project's Info tab > Configurations.
// Secrets.xcconfig lives in ../Config, gitignored, copied from Secrets.xcconfig.example.
#include? "../Config/Secrets.xcconfig"

INFOPLIST_KEY_SUPABASE_URL = $(SUPABASE_URL)
INFOPLIST_KEY_SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)

// PRD 15.1: CI and Release both fail the build on any compiler warning.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
