// Copy this file to Secrets.xcconfig (same folder) and fill in your own Supabase project
// values. Secrets.xcconfig is gitignored; never commit real values.
//
// Xcode xcconfig files treat // as the start of a comment, so URLs need the slash escaped
// with $() or the rest of the line is silently dropped.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY
